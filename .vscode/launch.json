{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run TypeRacer with PDFBox",
            "request": "launch",
            "mainClass": "TypeRacerMongolian",
            "classPaths": [
                "${workspaceFolder}",
                "${env:USERPROFILE}/.m2/repository/org/apache/pdfbox/pdfbox/2.0.30/pdfbox-2.0.30.jar",
                "${env:USERPROFILE}/.m2/repository/org/apache/pdfbox/fontbox/2.0.30/fontbox-2.0.30.jar",
                "${env:USERPROFILE}/.m2/repository/commons-logging/commons-logging/1.2/commons-logging-1.2.jar"
            ]
        }
    ]
}
